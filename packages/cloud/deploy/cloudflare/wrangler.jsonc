// OpenPencil Cloud on Cloudflare Workers. Without --env this runs locally against the TOML in
// ../generated/cloudflare.toml (see the end-to-end tests); `--env staging` is cloud-staging.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "openpencil-cloud-local",
  "main": "local.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "tsconfig": "../../src/runtime/cloudflare/tsconfig.json",
  // The deployment TOML is bundled as text and parsed when the Worker starts.
  "rules": [{ "type": "Text", "globs": ["**/*.toml"], "fallthrough": false }],
  "observability": { "enabled": true },
  // The Cloud portal, built by `bun run build:cloud-portal` at the repository root. The Worker
  // always answers first: API routes win, portal pages get `cloud.html`, and only then files.
  "assets": {
    "directory": "../../../../dist-cloud-portal",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  // Locally the connection string comes from CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE.
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "local" }],
  // One object per document holds its live collaboration rooms.
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "CollaborationRelayObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CollaborationRelayObject"] }],
  // Cleanup, and email that failed to send after its request.
  "triggers": { "crons": ["*/5 * * * *"] },
  "env": {
    "staging": {
      "name": "openpencil-cloud-staging",
      "main": "staging.ts",
      "routes": [{ "pattern": "cloud-staging.openpencil.dev", "custom_domain": true }],
      "workers_dev": false,
      "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "4e4c4652a8a14c77bfdb2d50862d2e64" }],
      "durable_objects": {
        "bindings": [{ "name": "RELAY", "class_name": "CollaborationRelayObject" }]
      },
      "send_email": [{ "name": "EMAIL" }],
      // Set with `wrangler secret put --env staging`, or by the Cloud workflow.
      "secrets": {
        "required": [
          "BETTER_AUTH_SECRET",
          "GOOGLE_CLIENT_ID",
          "GOOGLE_CLIENT_SECRET",
          "S3_ACCESS_KEY_ID",
          "S3_SECRET_ACCESS_KEY"
        ]
      }
    }
  }
}
