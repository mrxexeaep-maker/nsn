{
  "name": "@open-pencil/feedback",
  "version": "0.16.0-beta.1",
  "private": true,
  "license": "MIT",
  "description": "The OpenPencil feedback service on Cloudflare Workers: usage pings, opt-in usage stats, and the Cloud waitlist.",
  "type": "module",
  "imports": {
    "#feedback/*": "./src/*",
    "#feedback-tests/*": "./tests/*.ts"
  },
  "exports": {
    "./contract": "./src/contract/index.ts"
  },
  "scripts": {
    "dev": "wrangler dev",
    "test": "bun test tests",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json && bunx tsc --noEmit -p tsconfig.tests.json",
    "types": "wrangler types --include-runtime false",
    "check:types": "wrangler types --include-runtime false --check"
  },
  "dependencies": {
    "@open-pencil/scene-graph": "workspace:*",
    "es-toolkit": "^1.52.0",
    "hono": "^4.13.13",
    "kysely": "^0.29.6",
    "kysely-d1": "0.4.0",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@types/bun": "^1.3.14",
    "typescript": "~5.8.3",
    "wrangler": "4.149.0"
  }
}
